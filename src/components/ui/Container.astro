---
interface Props {
  class?: string;
  size?: 'default' | 'narrow' | 'wide';
}

const { class: className = '', size = 'default' } = Astro.props;

const sizeClasses = {
  narrow: 'max-w-5xl',
  default: 'max-w-[1340px]',
  wide: 'max-w-[1480px]',
};
---

<div class={`w-full mx-auto px-5 sm:px-8 lg:px-12 ${sizeClasses[size]} ${className}`}>
  <slot />
</div>
