---
import { SANDALWOOD_DATA } from '../../data/services';
import Container from '../ui/Container.astro';
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="sandalwood" class="py-24 sm:py-32 bg-[#FAF8F3] border-b border-[#202923]/10 scroll-mt-20">
  <Container>
    <Reveal>
      <SectionHeading
        label={SANDALWOOD_DATA.eyebrow}
        title={SANDALWOOD_DATA.heading}
        description={SANDALWOOD_DATA.description}
        align="split"
        theme="light"
      />
    </Reveal>

    <!-- Regulatory & Risk Disclaimer Callout Box -->
    <Reveal delay={100}>
      <div class="mb-12 p-4 sm:p-5 rounded-xs bg-[#B89B65]/15 border border-[#B89B65]/35 text-xs text-[#202923] flex items-start gap-3.5">
        <svg class="w-5 h-5 text-[#173D2B] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="leading-relaxed text-[#202923]/85 italic">
          {SANDALWOOD_DATA.disclaimer}
        </p>
      </div>
    </Reveal>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: 6 Structured Cultivation Offerings -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          SANDALWOOD_DATA.offerings.map((offering, idx) => (
            <Reveal delay={idx * 80} class="h-full">
              <div class="h-full p-5 sm:p-6 rounded-xs bg-white border border-[#202923]/12 hover:border-[#173D2B] transition-all flex flex-col justify-between shadow-xs hover:shadow-md">
                <div>
                  <span class="text-xs font-mono font-bold text-[#B89B65] block mb-2">
                    PHASE 0{idx + 1}
                  </span>
                  <h4 class="font-serif text-lg text-[#102B20] mb-2 leading-snug">
                    {offering.title}
                  </h4>
                  <p class="text-xs text-[#202923]/75 leading-relaxed">
                    {offering.desc}
                  </p>
                </div>
                <div class="pt-3 mt-4 border-t border-[#202923]/8 text-[10px] font-mono text-[#6E8061]">
                  Silviculture Best Practice
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>

      <!-- Right Column: Framed Plantation Image -->
      <div class="lg:col-span-5">
        <Reveal delay={200}>
          <div class="relative rounded-sm overflow-hidden shadow-xl bg-[#102B20] aspect-[3/4] group">
            <img
              src={SANDALWOOD_DATA.image}
              alt={SANDALWOOD_DATA.imageAlt}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#102B20]/90 via-[#102B20]/20 to-transparent"></div>

            <div class="absolute bottom-6 left-6 right-6 p-5 bg-[#102B20]/90 backdrop-blur-md border border-[#B89B65]/30 rounded-xs text-[#F5F2E9]">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#B89B65] block mb-1">
                Santalum Album Stewardship
              </span>
              <h4 class="font-serif text-lg text-[#F5F2E9] mb-1">
                Agroforestry Companion Design
              </h4>
              <p class="text-xs text-[#F5F2E9]/75 leading-relaxed">
                Intercropping high-value heartwood species with nitrogen-fixing host companion plants for sustainable arboriculture.
              </p>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
