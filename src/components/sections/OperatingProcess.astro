---
import { OPERATING_PROCESS_DATA } from '../../data/roadmap';
import Container from '../ui/Container.astro';
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="operations" class="py-24 sm:py-32 bg-[#FAF8F3] border-b border-[#202923]/10 scroll-mt-20">
  <Container>
    <Reveal>
      <SectionHeading
        label={OPERATING_PROCESS_DATA.eyebrow}
        title={OPERATING_PROCESS_DATA.heading}
        description={OPERATING_PROCESS_DATA.description}
        align="split"
        theme="light"
      />
    </Reveal>

    <!-- 7-Stage Operating Workflow Timeline -->
    <div class="mb-16">
      <div class="hidden lg:grid grid-cols-7 gap-3 relative">
        <div class="absolute top-5 left-4 right-4 h-px bg-gradient-to-r from-[#173D2B]/30 via-[#B89B65] to-[#173D2B]/30 z-0"></div>

        {
          OPERATING_PROCESS_DATA.stages.map((stage, idx) => (
            <Reveal delay={idx * 60} class="h-full">
              <div class="relative z-10 flex flex-col items-center text-center p-2.5 h-full group">
                <div class="w-10 h-10 rounded-full bg-[#102B20] border-2 border-[#B89B65] text-[#F5F2E9] flex items-center justify-center font-mono text-xs font-bold mb-3 group-hover:bg-[#173D2B] transition-colors">
                  {stage.step}
                </div>
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#173D2B] mb-1">
                  {stage.name}
                </span>
                <h4 class="font-serif text-xs font-bold text-[#102B20] mb-1.5 leading-snug">
                  {stage.title}
                </h4>
                <p class="text-[11px] text-[#202923]/75 leading-relaxed mb-2 font-light">
                  {stage.description}
                </p>
                <div class="mt-auto pt-2 border-t border-[#202923]/8 w-full text-[9px] font-mono text-[#6E8061]">
                  {stage.stakeholderInvolved}
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>

      <!-- Mobile Timeline -->
      <div class="lg:hidden flex flex-col gap-4">
        {
          OPERATING_PROCESS_DATA.stages.map((stage) => (
            <div class="p-4 bg-white border border-[#202923]/10 rounded-xs flex items-start gap-4">
              <div class="w-9 h-9 rounded-full bg-[#102B20] text-[#B89B65] flex items-center justify-center font-mono text-xs font-bold shrink-0">
                {stage.step}
              </div>
              <div class="flex-1">
                <span class="text-[10px] font-mono font-bold text-[#173D2B] uppercase tracking-wider block mb-0.5">
                  {stage.name}
                </span>
                <h4 class="font-serif text-sm font-bold text-[#102B20] mb-1">
                  {stage.title}
                </h4>
                <p class="text-xs text-[#202923]/75 leading-relaxed mb-2">
                  {stage.description}
                </p>
                <span class="text-[10px] font-mono text-[#6E8061] block">
                  Lead: {stage.stakeholderInvolved}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 2 Illustrative Use Case Scenarios -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        OPERATING_PROCESS_DATA.scenarios.map((scenario, idx) => (
          <Reveal delay={idx * 150} class="h-full">
            <div class="h-full bg-white border border-[#202923]/15 rounded-sm p-7 sm:p-8 flex flex-col justify-between shadow-xs">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#B89B65]">
                    {scenario.badge}
                  </span>
                  <span class="text-[10px] font-mono italic text-[#6E8061]">
                    * {scenario.note}
                  </span>
                </div>

                <h3 class="font-serif text-2xl text-[#102B20] mb-3">
                  {scenario.title}
                </h3>

                <!-- Persona & Challenge -->
                <div class="p-4 rounded-xs bg-[#FAF8F3] border border-[#202923]/10 mb-5 text-xs">
                  <div class="mb-2">
                    <strong class="text-[#102B20] block mb-0.5">Context Persona:</strong>
                    <span class="text-[#202923]/80">{scenario.persona}</span>
                  </div>
                  <div>
                    <strong class="text-[#102B20] block mb-0.5">Underlying Challenge:</strong>
                    <span class="text-[#202923]/80">{scenario.problem}</span>
                  </div>
                </div>

                <!-- Step-by-Step Workflow Resolution -->
                <div class="mb-5">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[#173D2B] font-semibold block mb-2">
                    Proposed Service Execution Pathway:
                  </span>
                  <ol class="space-y-2 text-xs text-[#202923]/80" role="list">
                    {scenario.workflow.map((step, sIdx) => (
                      <li class="flex items-start gap-2">
                        <span class="font-mono text-[#B89B65] font-bold">0{sIdx + 1}.</span>
                        <span>{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>

              <!-- End Result -->
              <div class="pt-4 border-t border-[#202923]/10 bg-[#173D2B]/5 -mx-7 -mb-7 sm:-mx-8 sm:-mb-8 p-5 rounded-b-sm">
                <span class="text-[10px] font-mono uppercase tracking-wider text-[#173D2B] font-semibold block mb-1">
                  Expected Ecosystem Outcome:
                </span>
                <p class="text-xs text-[#102B20] font-medium leading-relaxed">
                  {scenario.outcome}
                </p>
              </div>
            </div>
          </Reveal>
        ))
      }
    </div>
  </Container>
</section>
