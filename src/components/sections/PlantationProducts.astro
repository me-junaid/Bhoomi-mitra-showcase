---
import { PRODUCTS_CATALOGUE } from '../../data/services';
import Container from '../ui/Container.astro';
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="products" class="py-24 sm:py-32 bg-[#F5F2E9] border-b border-[#202923]/10 scroll-mt-20">
  <Container>
    <Reveal>
      <SectionHeading
        label={PRODUCTS_CATALOGUE.eyebrow}
        title={PRODUCTS_CATALOGUE.heading}
        description={PRODUCTS_CATALOGUE.description}
        align="split"
        theme="light"
      />
    </Reveal>

    <!-- Catalogue Disclaimer Banner -->
    <Reveal delay={100}>
      <div class="mb-10 p-4 rounded-xs bg-[#173D2B]/10 border border-[#173D2B]/20 text-xs text-[#173D2B] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#B89B65]"></span>
          <span class="font-mono font-semibold uppercase tracking-wider text-[11px]">
            Future Commercial Division
          </span>
        </div>
        <span class="text-[11px] italic text-[#202923]/70 font-mono">
          * {PRODUCTS_CATALOGUE.disclaimer}
        </span>
      </div>
    </Reveal>

    <!-- 4 Product Categories Catalogue Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        PRODUCTS_CATALOGUE.categories.map((cat, idx) => (
          <Reveal delay={idx * 90} class="h-full">
            <article class="h-full bg-white border border-[#202923]/12 rounded-sm overflow-hidden flex flex-col justify-between shadow-xs hover:border-[#173D2B] transition-all hover:shadow-md group">
              <div>
                <div class="relative aspect-[4/3] overflow-hidden bg-[#102B20]">
                  <img
                    src={cat.image}
                    alt={cat.name}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#102B20]/75 via-transparent to-transparent"></div>
                  <span class="absolute bottom-2.5 left-3 text-[10px] font-mono uppercase tracking-wider text-[#CDB78C]">
                    {cat.category}
                  </span>
                </div>

                <div class="p-5">
                  <h4 class="font-serif text-lg text-[#102B20] mb-2 group-hover:text-[#173D2B] transition-colors">
                    {cat.name}
                  </h4>
                  <p class="text-xs text-[#202923]/75 leading-relaxed mb-4">
                    {cat.description}
                  </p>

                  <div class="pt-3 border-t border-[#202923]/8">
                    <span class="text-[10px] font-mono text-[#6E8061] uppercase tracking-wider block mb-1.5">
                      Illustrative Stock Scope:
                    </span>
                    <ul class="space-y-1 text-xs text-[#202923]/80" role="list">
                      {cat.sampleItems.map((item) => (
                        <li class="flex items-start gap-1.5 text-[11px]">
                          <span class="text-[#B89B65]">•</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-[#FAF8F3] border-t border-[#202923]/8 flex items-center justify-between text-[11px] font-mono text-[#6E8061]">
                <span>Catalogue Horizon</span>
                <span class="text-[#173D2B] font-semibold">Planned Division</span>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </Container>
</section>
