---
import { TECH_PLATFORM_DATA } from '../../data/roadmap';
import Container from '../ui/Container.astro';
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="technology" class="py-24 sm:py-32 bg-[#FAF8F3] border-b border-[#202923]/10 scroll-mt-20">
  <Container>
    <Reveal>
      <SectionHeading
        label={TECH_PLATFORM_DATA.eyebrow}
        title={TECH_PLATFORM_DATA.heading}
        description={TECH_PLATFORM_DATA.description}
        align="split"
        theme="light"
      />
    </Reveal>

    <!-- Concept Disclaimer Banner -->
    <Reveal delay={80}>
      <div class="mb-12 p-4 sm:p-5 rounded-xs bg-[#173D2B]/10 border border-[#173D2B]/25 text-xs text-[#173D2B] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#B89B65] animate-pulse"></span>
          <span class="font-mono font-bold uppercase tracking-wider text-[11px]">
            Future Architecture Concept
          </span>
        </div>
        <p class="text-[11px] italic text-[#202923]/75 max-w-xl text-right">
          {TECH_PLATFORM_DATA.disclaimer}
        </p>
      </div>
    </Reveal>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Column: Smartphone Mockup Conceptual Representation -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <!-- Prominent Prompt Required Label -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#173D2B]/10 border border-[#173D2B]/20 text-[#173D2B] mb-4 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-[#B89B65] animate-pulse"></span>
          <span class="font-mono font-bold text-[11px] uppercase tracking-wider">
            Proposed Application Concept — Not Yet Launched
          </span>
        </div>

        <Reveal delay={150}>
          <!-- Smartphone Outer Chassis -->
          <div class="w-[300px] sm:w-[330px] rounded-[40px] bg-[#102B20] p-4 shadow-2xl border-4 border-[#B89B65]/40 relative">
            <!-- Screen Speaker Notch -->
            <div class="w-24 h-4 bg-black/60 rounded-full mx-auto mb-3"></div>

            <!-- Conceptual App Interface Screen -->
            <div class="rounded-[28px] bg-[#FAF8F3] overflow-hidden border border-[#202923]/15 text-[#202923] p-4 flex flex-col gap-3 min-h-[520px]">
              <!-- Mock App Header -->
              <div class="flex items-center justify-between pb-2 border-b border-[#202923]/10">
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 rounded-xs bg-[#173D2B] text-[#B89B65] flex items-center justify-center text-[10px] font-bold">
                    BM
                  </div>
                  <span class="font-serif font-bold text-xs text-[#102B20]">Bhoomi Portal</span>
                </div>
                <span class="text-[8px] font-mono px-2 py-0.5 rounded-full bg-[#173D2B]/10 text-[#173D2B] font-semibold">
                  Conceptual Preview
                </span>
              </div>

              <!-- Mock Farmland Parcel Card -->
              <div class="rounded-xs bg-white border border-[#202923]/10 p-3 shadow-xs">
                <div class="flex items-center justify-between text-[10px] font-mono text-[#6E8061] mb-1">
                  <span>Estate Status: Active</span>
                  <span>Mysuru East</span>
                </div>
                <h5 class="font-serif text-sm text-[#102B20] mb-0.5">Kaveri Basin Orchard</h5>
                <p class="text-[10px] text-[#202923]/70 mb-2">4.5 Acres • Red Loam • Sandalwood + Host</p>

                <!-- Mock Mini Metrics -->
                <div class="grid grid-cols-3 gap-1.5 pt-2 border-t border-[#202923]/5 text-center">
                  <div class="p-1 rounded-xs bg-[#FAF8F3]">
                    <span class="block text-[8px] text-[#202923]/60 uppercase">Moisture</span>
                    <span class="text-[10px] font-mono font-bold text-[#173D2B]">Optimum</span>
                  </div>
                  <div class="p-1 rounded-xs bg-[#FAF8F3]">
                    <span class="block text-[8px] text-[#202923]/60 uppercase">Solar Pump</span>
                    <span class="text-[10px] font-mono font-bold text-[#173D2B]">Active</span>
                  </div>
                  <div class="p-1 rounded-xs bg-[#FAF8F3]">
                    <span class="block text-[8px] text-[#202923]/60 uppercase">Fence</span>
                    <span class="text-[10px] font-mono font-bold text-[#173D2B]">Secured</span>
                  </div>
                </div>
              </div>

              <!-- Mock Telemetry Log Feed -->
              <div class="rounded-xs bg-white border border-[#202923]/10 p-3 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-mono text-[#B89B65] uppercase tracking-wider block mb-1">
                    Latest Activity Feed
                  </span>
                  <div class="space-y-2 text-[10px] text-[#202923]/75">
                    <div class="pb-1.5 border-b border-[#202923]/5">
                      <strong class="text-[#102B20] block">Scheduled Irrigation Cycle</strong>
                      <span>Drip cycle completed. 4,200L allocated.</span>
                    </div>
                    <div class="pb-1.5 border-b border-[#202923]/5">
                      <strong class="text-[#102B20] block">Agronomy Inspection</strong>
                      <span>Soil microbial activity verified normal.</span>
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-[#202923]/10 text-center">
                  <span class="text-[9px] font-mono text-[#6E8061] italic">
                    Prototype Screen Illustration
                  </span>
                </div>
              </div>
            </div>

            <!-- Home indicator bar -->
            <div class="w-28 h-1 bg-white/40 rounded-full mx-auto mt-3"></div>
          </div>
        </Reveal>
      </div>

      <!-- Right Column: 6 Planned Technology Modules -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        {
          TECH_PLATFORM_DATA.plannedModules.map((mod, idx) => (
            <Reveal delay={idx * 60}>
              <div class="p-5 rounded-xs bg-white border border-[#202923]/12 hover:border-[#173D2B] transition-all flex items-start gap-4 shadow-xs">
                <span class="font-mono text-xs font-bold text-[#B89B65] mt-0.5 shrink-0">
                  0{idx + 1}
                </span>
                <div>
                  <h4 class="font-serif text-lg text-[#102B20] mb-1">
                    {mod.title}
                  </h4>
                  <p class="text-xs text-[#202923]/75 leading-relaxed">
                    {mod.desc}
                  </p>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </Container>
</section>
