---
import { SINGLE_PAGE_NAV, NAV_CTA } from '../../data/navigation';
import BrandLogo from '../ui/BrandLogo.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
---

<!-- Reading Progress Bar -->
<div
  id="scroll-progress-bar"
  class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-[#B89B65] via-[#CDB78C] to-[#B89B65] z-[60] w-0 transition-all duration-75 pointer-events-none"
  aria-hidden="true"
></div>

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-3.5 sm:py-4 border-b border-white/10"
>
  <Container>
    <div class="flex items-center justify-between">
      <!-- Official Brand Logo -->
      <BrandLogo theme="light" size="sm" showTagline={true} />

      <!-- Desktop Single-Page Navigation -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Investor Showcase Navigation">
        {
          SINGLE_PAGE_NAV.map((item) => (
            <a
              href={item.href}
              data-nav-target={item.href}
              class="nav-link text-xs xl:text-sm font-medium tracking-wide uppercase text-[#F5F2E9]/80 hover:text-[#B89B65] transition-colors duration-200 relative py-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B89B65] rounded-xs group"
            >
              {item.label}
              <span class="nav-indicator absolute bottom-0 left-0 w-0 h-[1.5px] bg-[#B89B65] transition-all duration-300 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <!-- Desktop Primary CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <Button href={NAV_CTA.href} variant="gold" size="sm" hasArrow>
          {NAV_CTA.label}
        </Button>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden relative z-50 inline-flex items-center justify-center p-2 rounded-xs text-[#F5F2E9] hover:text-[#B89B65] hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B89B65] transition-colors cursor-pointer"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span class="sr-only">Toggle navigation menu</span>
        <svg
          id="menu-icon-open"
          class="block h-6 w-6 pointer-events-none"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden h-6 w-6 pointer-events-none text-[#B89B65]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </Container>
</header>

<!-- Mobile Drawer Menu (Outside <header> so backdrop-filter on header never traps or clips it) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-[#102B20] text-[#F5F2E9] pt-24 sm:pt-28 pb-8 px-6 flex flex-col justify-between overflow-y-auto lg:hidden transition-all duration-300 ease-in-out pointer-events-none invisible opacity-0 translate-x-full"
  aria-hidden="true"
>
  <div class="flex flex-col gap-4 max-w-lg mx-auto w-full">
    <div class="flex items-center justify-between pb-3 border-b border-white/10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#B89B65]">
        Presentation Sections
      </span>
      <span class="text-[10px] font-mono text-[#F5F2E9]/60">Topic Flow</span>
    </div>

    <nav class="flex flex-col gap-1" aria-label="Mobile Navigation">
      {
        SINGLE_PAGE_NAV.map((item, idx) => (
          <a
            href={item.href}
            class="mobile-nav-link text-xl font-serif text-[#F5F2E9] hover:text-[#B89B65] active:text-[#B89B65] transition-colors duration-200 py-3 border-b border-white/5 flex items-center justify-between group"
            style={`animation-delay: ${idx * 30}ms;`}
          >
            <span>{item.label}</span>
            <svg class="w-4 h-4 text-[#B89B65]/60 group-hover:text-[#B89B65] group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="pt-6 pb-2 flex flex-col gap-4 border-t border-white/10 max-w-lg mx-auto w-full">
    <div class="text-xs text-[#F5F2E9]/70 leading-relaxed font-light">
      Bhoomi Mitra — Single-Page Investor Showcase &amp; Company Concept Presentation.
    </div>
    <Button href={NAV_CTA.href} variant="gold" size="lg" class="w-full text-center mobile-cta" hasArrow>
      {NAV_CTA.label}
    </Button>
  </div>
</div>

<script>
  function setupSinglePageHeader() {
    const header = document.getElementById('site-header');
    const progressBar = document.getElementById('scroll-progress-bar');
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const desktopLinks = document.querySelectorAll('.nav-link');

    if (!toggleBtn || !mobileMenu) return;

    // Avoid duplicate event listener attachments on Astro page reloads / transitions
    if (toggleBtn.dataset.menuInitialized === 'true') return;
    toggleBtn.dataset.menuInitialized = 'true';

    // Mobile menu state
    let isOpen = false;

    // Scroll progress bar calculation & header styling
    function updateProgress() {
      if (progressBar) {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = `${scrollPercent}%`;
      }

      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      if (header) {
        if (scrollTop > 30 || isOpen) {
          header.classList.add('bg-[#102B20]/95', 'backdrop-blur-md', 'shadow-md', 'border-[#B89B65]/20');
          header.classList.remove('border-white/10');
        } else {
          header.classList.remove('bg-[#102B20]/95', 'backdrop-blur-md', 'shadow-md', 'border-[#B89B65]/20');
          header.classList.add('border-white/10');
        }
      }

      // Active Section Spy
      const sections = ['overview', 'ecosystem', 'solutions', 'revenue-model', 'technology', 'roadmap'];
      let currentSection = '';

      for (const id of sections) {
        const el = document.getElementById(id);
        if (el) {
          const rect = el.getBoundingClientRect();
          if (rect.top <= 140 && rect.bottom >= 140) {
            currentSection = `#${id}`;
            break;
          }
        }
      }

      desktopLinks.forEach((link) => {
        const target = link.getAttribute('data-nav-target');
        const indicator = link.querySelector('.nav-indicator');
        if (target === currentSection) {
          link.classList.add('text-[#B89B65]');
          link.classList.remove('text-[#F5F2E9]/80');
          indicator?.classList.add('w-full');
        } else {
          link.classList.remove('text-[#B89B65]');
          link.classList.add('text-[#F5F2E9]/80');
          indicator?.classList.remove('w-full');
        }
      });
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    function toggleMenu(open?: boolean) {
      if (!toggleBtn || !mobileMenu) return;
      isOpen = open !== undefined ? open : !isOpen;

      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileMenu.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        mobileMenu.classList.remove('translate-x-full', 'pointer-events-none', 'invisible', 'opacity-0');
        mobileMenu.classList.add('translate-x-0', 'pointer-events-auto', 'visible', 'opacity-100');
        iconOpen?.classList.add('hidden');
        iconOpen?.classList.remove('block');
        iconClose?.classList.remove('hidden');
        iconClose?.classList.add('block');
        document.documentElement.classList.add('overflow-hidden');
        document.body.classList.add('overflow-hidden');
        if (header) {
          header.classList.add('bg-[#102B20]/95', 'backdrop-blur-md', 'border-[#B89B65]/20');
          header.classList.remove('border-white/10');
        }
      } else {
        mobileMenu.classList.remove('translate-x-0', 'pointer-events-auto', 'visible', 'opacity-100');
        mobileMenu.classList.add('translate-x-full', 'pointer-events-none', 'invisible', 'opacity-0');
        iconOpen?.classList.remove('hidden');
        iconOpen?.classList.add('block');
        iconClose?.classList.add('hidden');
        iconClose?.classList.remove('block');
        document.documentElement.classList.remove('overflow-hidden');
        document.body.classList.remove('overflow-hidden');
        updateProgress();
      }
    }

    // Toggle button event
    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    });

    // Close when tapping any link inside the mobile menu
    const menuLinks = mobileMenu.querySelectorAll('a');
    menuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });

    // Close if resized to desktop breakpoint (>= 1024px)
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isOpen) {
        toggleMenu(false);
      }
    });
  }

  setupSinglePageHeader();
  document.addEventListener('astro:page-load', setupSinglePageHeader);
</script>