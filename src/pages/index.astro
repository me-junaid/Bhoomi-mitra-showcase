---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CompanyOverview from '../components/sections/CompanyOverview.astro';
import VisionMission from '../components/sections/VisionMission.astro';
import BusinessEcosystem from '../components/sections/BusinessEcosystem.astro';
import FarmlandMarketplace from '../components/sections/FarmlandMarketplace.astro';
import LandManagement from '../components/sections/LandManagement.astro';
import SandalwoodPlantation from '../components/sections/SandalwoodPlantation.astro';
import Landscaping from '../components/sections/Landscaping.astro';
import Agronomy from '../components/sections/Agronomy.astro';
import PlantationProducts from '../components/sections/PlantationProducts.astro';
import TrustFramework from '../components/sections/TrustFramework.astro';
import ExpertNetwork from '../components/sections/ExpertNetwork.astro';
import RevenueModel from '../components/sections/RevenueModel.astro';
import TechnologyPlatform from '../components/sections/TechnologyPlatform.astro';
import Leadership from '../components/sections/Leadership.astro';
import OperatingProcess from '../components/sections/OperatingProcess.astro';
import GrowthRoadmap from '../components/sections/GrowthRoadmap.astro';

const seoTitle = "Bhoomi Mitra | Farmland & Agricultural Ecosystem";
const seoDescription = "Explore Bhoomi Mitra's proposed integrated ecosystem for farmland discovery, land management, plantation solutions, and agricultural expertise.";
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <!-- SECTION 01 — COVER / HERO -->
  <Hero />

  <!-- SECTION 02 — COMPANY OVERVIEW -->
  <CompanyOverview />

  <!-- SECTION 03 — VISION, MISSION & VALUES -->
  <VisionMission />

  <!-- SECTION 04 — BUSINESS ECOSYSTEM OVERVIEW -->
  <BusinessEcosystem />

  <!-- SECTION 05 — MANAGED FARMLAND MARKETPLACE (PILLAR 01) -->
  <FarmlandMarketplace />

  <!-- SECTION 06 — FARMLAND MANAGEMENT SERVICES (PILLAR 02) -->
  <LandManagement />

  <!-- SECTION 07 — SANDALWOOD & PLANTATION SOLUTIONS -->
  <SandalwoodPlantation />

  <!-- SECTION 08 — LANDSCAPING SERVICES -->
  <Landscaping />

  <!-- SECTION 09 — AGRICULTURE & AGRONOMY -->
  <Agronomy />

  <!-- SECTION 10 — PLANTATION PRODUCTS -->
  <PlantationProducts />

  <!-- SECTION 11 — VERIFICATION & TRUST FRAMEWORK -->
  <TrustFramework />

  <!-- SECTION 12 — NETWORK OF EXPERTS & PARTNERS -->
  <ExpertNetwork />

  <!-- SECTION 13 — REVENUE MODEL -->
  <RevenueModel />

  <!-- SECTION 14 — TECHNOLOGY PLATFORM -->
  <TechnologyPlatform />

  <!-- SECTION 15 — FOUNDER, CO-FOUNDER & TEAM -->
  <Leadership />

  <!-- SECTION 16 — OPERATING PROCESS & CASE STUDIES -->
  <OperatingProcess />

  <!-- SECTION 17 — GROWTH ROADMAP & SUSTAINABILITY -->
  <GrowthRoadmap />
</BaseLayout>
